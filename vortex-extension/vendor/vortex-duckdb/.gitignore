# cpp.rs is generated by rust-bindgen in build.rs. Even though rust-bindgen is
# version pinned as part of the lock file, it can generate different output
# across machines. rust-bindgen loads libclang dynamically from a system-wide path.
src/cpp.rs

# cbindgen invokes Cargo metadata from this vendored crate and may create a
# nested lockfile. The extension is built with the repository-level lockfile.
Cargo.lock

# Symlinked DuckDB source is ignored. It is downloaded, extracted and symlinked as part of build.rs
duckdb
!src/duckdb
